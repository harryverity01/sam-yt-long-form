# Copy to .env and fill in your keys. Never commit .env.

# Required for transcription (Scribe) and music compose
ELEVENLABS_API_KEY=

# Optional: Seedance text-to-video for generic concept b-roll
FAL_KEY=

# Optional: stock b-roll fallback
PEXELS_API_KEY=

# Optional, demo-screenrec: a Chromium binary if Playwright's default is missing (cloud images)
# DEMO_CHROME=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
